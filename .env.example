# ──────────────────────────────────────────────
# LLM Usage Metering & Billing Engine
# Environment Variables — COPY TO .env AND FILL
# NEVER commit .env to version control
# ──────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://billing:billing_secret@localhost:5432/billing_engine
DATABASE_URL_SYNC=postgresql+psycopg2://billing:billing_secret@localhost:5432/billing_engine

# Application
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Stripe (test mode only — never use live keys)
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_PRO=price_1QtestProPlan000000
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# Plans — default plan limits
FREE_PLAN_API_CALL_LIMIT=1000
FREE_PLAN_TOKEN_LIMIT=100000
PRO_PLAN_API_CALL_LIMIT=100000
PRO_PLAN_TOKEN_LIMIT=10000000

# Pricing (in micro-cents per unit — integer only, never float)
# Input tokens: price per 1,000,000 tokens in micro-cents
TOKEN_PRICE_INPUT_MICRO_CENTS_PER_M=150000000
# Cached input tokens (cheaper)
TOKEN_PRICE_CACHED_INPUT_MICRO_CENTS_PER_M=75000000
# Output tokens (includes reasoning)
TOKEN_PRICE_OUTPUT_MICRO_CENTS_PER_M=600000000
# API call price in micro-cents per call
API_CALL_PRICE_MICRO_CENTS=100

# Background job
ROLLUP_JOB_INTERVAL_SECONDS=3600
